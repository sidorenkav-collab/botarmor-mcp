{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sidorenkav-collab/botarmor",
  "title": "BotArmor: LLM red teaming for chatbots",
  "description": "LLM red teaming and prompt injection testing for chatbots and AI agents: A-F grade, prompt fixes.",
  "icons": [
    {
      "src": "https://botarmor.eu/favicon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/sidorenkav-collab/botarmor-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "websiteUrl": "https://botarmor.eu/agents/#mcp",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@botarmor/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BOTARMOR_API_KEY",
          "description": "BotArmor API key (ba_live_...), from the client area, tab API",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.botarmor.eu/mcp"
    }
  ]
}
