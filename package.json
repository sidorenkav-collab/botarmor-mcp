  "description": "MCP server for BotArmor: crash-test your chatbot or AI agent from Claude Code, Cursor or any MCP client, and get a report the model can turn into fixes.",
  "type": "module",
  "license": "MIT",
  "author": "BotArmor AI (Rhone IA)",
  "homepage": "https://github.com/sidorenkav-collab/botarmor-mcp#readme",
  "repository": {
