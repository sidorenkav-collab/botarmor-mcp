    "url": "git+https://github.com/sidorenkav-collab/botarmor-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sidorenkav-collab/botarmor-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
